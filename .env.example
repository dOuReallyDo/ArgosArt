# ─── ArgosArt Configuration (.env) ──────────────────────────────
# Copy to .env and fill in values

# Environment: development | production
ARGOS_ENV=development

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/argosart.db

# ─── Qdrant (Vector Database) ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage ───────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=./data/portfolio

# ─── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEY=
ENCRYPTION_ENABLED=true

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Embedding Models ──────────────────────────────────────────
TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-large
IMAGE_EMBEDDING_MODEL=openai/clip-vit-large-patch14
EMBEDDING_DEVICE=cpu

# ─── Art Features ──────────────────────────────────────────────
COLOR_ANALYSIS_ENABLED=true
STYLE_TAGGING_ENABLED=true
MAX_IMAGE_RESOLUTION=4096

# ─── GLM-OCR ───────────────────────────────────────────────────
GLM_OCR_ENABLED=false

# ─── Whisper ────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ─── Limits ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=1800
MAX_AUDIO_DURATION_SECONDS=3600
MAX_PDF_PAGES=500

# ─── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ─── Frontend ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["*"]
